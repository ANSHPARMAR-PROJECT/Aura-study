# Generate a strong secret with:
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
FLASK_ENV=development
FLASK_DEBUG=false
COOKIE_SECURE=false
AUTO_CREATE_DB=true
PORT=5000
JWT_ACCESS_TOKEN_HOURS=12
AURA_ALLOWED_HOSTS=localhost,127.0.0.1
TRUSTED_PROXY_COUNT=0

# Leave unset to use the local SQLite database (backend/study_planner.db).
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://aura_user:change_me@localhost:5432/aura_study

# Optional AI integration. Without a key, AURA uses its deterministic/offline features.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
